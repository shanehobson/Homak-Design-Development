---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import ArrowLink from '../components/ArrowLink.astro';
import EnquiryModal from '../components/EnquiryModal.astro';
import { site } from '../data/site';

/* Builds to `dist/404.html`. CloudFront has to be told to serve it with a
   404 status for unknown paths (a custom error response on the distribution);
   until then unknown URLs still fall through to the homepage as soft 404s. */
---

<Base
  title={`Page not found | ${site.shortName}`}
  description="There is nothing at this address. Head back to the Homak homepage."
  robots="noindex, follow"
>
  <Header />

  <main class="stack">
    <section class="section notfound" aria-labelledby="notfound-title">
      <div class="container">
        <p class="notfound__code reveal">404</p>
        <h1 class="section-title notfound__title reveal" id="notfound-title" style="--reveal-delay: 80ms">
          Page not found
        </h1>
        <p class="notfound__lede reveal" style="--reveal-delay: 160ms">
          There's nothing at this address. The link may be out of date, or the page has moved.
        </p>
        <div class="reveal" style="--reveal-delay: 240ms">
          <ArrowLink href="/" size="lg">Back to the homepage</ArrowLink>
        </div>
      </div>
    </section>
  </main>

  <EnquiryModal />
</Base>

<style>
  .stack { position: relative; z-index: 1; }

  .notfound { padding-top: calc(var(--header-h) + 2.5rem); }
  .notfound .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.5rem;
  }

  .notfound__code {
    font-size: var(--t-menu);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
  }
  .notfound__title { text-align: center; }
  .notfound__lede { color: var(--text-muted); max-width: 46ch; }
</style>

<script>
  import '../scripts/reveal';
</script>

---
import { Image } from 'astro:assets';
import { team, teamBio } from '../../data/team';
---

<section class="section" id="about" data-section="about" aria-labelledby="about-title">
  <div class="container">
    <h2 class="section-title reveal" id="about-title">Meet our team</h2>

    <ul class="grid">
      {team.map((person, i) => (
        <li class="card reveal" style={`--reveal-delay: ${120 + i * 120}ms`}>
          {/* The cards render the photo at ~314px on mobile and ~282-318px on
              desktop, so 2x/3x screens need the 608 and 912 candidates. Both
              sources are 4:5 and over 1000px wide, which is what keeps those
              two generating -- sharp will not upscale past the intrinsic width. */}
          <Image
            class="card__photo"
            src={person.photo}
            alt={`${person.name}, ${person.role}`}
            widths={[304, 608, 912]}
            sizes="(max-width: 620px) 314px, 318px"
            quality={90}
          />
          <div class="card__meta">
            <p class="card__name">{person.name}</p>
            <p class="card__role">{person.role}</p>
          </div>
        </li>
      ))}
    </ul>

    <p class="bio reveal" style="--reveal-delay: 360ms">{teamBio}</p>
  </div>
</section>

<style>
  .grid {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.25rem, 6.4vw, 5.75rem);
    justify-content: center;
    max-width: 740px;
    margin-inline: auto;
  }

  .card {
    border: 1px solid var(--accent);
    padding: clamp(0.75rem, 1.5vw, 1.25rem);
    background: #ffffff08;
  }

  .card__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .card__meta { padding: 0.85rem 0.25rem 0.15rem; }
  .card__name { font-size: var(--t-card); line-height: 1.3; }
  .card__role { font-size: var(--t-menu); color: var(--text-muted); line-height: 1.4; }

  .bio {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    color: var(--text-muted);
    max-width: 78ch;
    margin-inline: auto;
  }

  @media (max-width: 620px) {
    .grid { grid-template-columns: minmax(0, 1fr); max-width: 340px; }
  }
</style>

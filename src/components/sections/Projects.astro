---
import { Image } from 'astro:assets';
import { projects, projectPath } from '../../data/projects';
import VideoModal from '../VideoModal.astro';
---

<section class="section" id="work" data-section="work" aria-labelledby="work-title">
  <div class="container">
    <h2 class="section-title reveal" id="work-title">Our projects</h2>

    <ul class="grid reveal" style="--reveal-delay: 140ms">
      {projects.map((project) => (
        <li>
          {/* A real link to the case study, so crawlers get a URL per project
              to follow. With JS, `VideoModal.astro` intercepts the click and
              opens the in-page preview instead; the modal links on to the
              full page. */}
          <a
            class="project"
            href={projectPath(project.slug)}
            data-project={project.slug}
            aria-haspopup="dialog"
          >
            <span class="project__frame">
              <Image
                class="project__img"
                src={project.poster}
                alt={`${project.title} — ${project.category}`}
                widths={[420, 840]}
                sizes="(max-width: 640px) 90vw, (max-width: 1000px) 44vw, 360px"
              />
              {project.video && (
                <span class="project__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg>
                </span>
              )}
            </span>
            <span class="project__meta">
              <span class="project__title">{project.title}</span>
              <span class="project__cat">{project.category}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <VideoModal />
</section>

<style>
  .grid {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
    gap: clamp(2rem, 3vw, 2.5rem) clamp(1rem, 2.5vw, 2rem);
  }

  .project {
    display: block;
    width: 100%;
    text-align: left;
  }

  .project__frame {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: #ffffff05;
    transition: border-color 350ms var(--ease);
  }

  .project__img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 11;
    object-fit: cover;
    object-position: top center;
    transition: transform 700ms var(--ease), opacity 350ms var(--ease);
  }

  .project__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 0;
    background: #0a0a0a55;
    transition: opacity 350ms var(--ease);
  }
  .project__play svg {
    width: 3rem; height: 3rem;
    color: var(--text);
    border: 1px solid var(--accent);
    border-radius: 50%;
    padding: 0.75rem;
    background: #0a0a0a99;
  }

  .project:hover .project__frame,
  .project:focus-visible .project__frame { border-color: var(--accent); }
  .project:hover .project__img { transform: scale(1.04); }
  .project:hover .project__play { opacity: 1; }

  .project__meta { display: block; padding-top: 0.9rem; }
  .project__title { display: block; font-size: var(--t-card); line-height: 1.3; }
  .project__cat {
    display: block;
    font-size: var(--t-menu);
    color: var(--text-muted);
    line-height: 1.5;
  }

</style>

---
import ArrowLink from '../ArrowLink.astro';
import { site, addressLine, projectEnquiry } from '../../data/site';
---

{/* Placeholder shell. The comp for this section is empty — real details land
    here as a content drop, no layout work needed. */}
<section class="section" id="contact" data-section="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 class="section-title reveal" id="contact-title">Let's talk</h2>

    <div class="contact reveal" style="--reveal-delay: 140ms">
      <p class="contact__lede">
        Tell us what you're building. We'll come back to you within two business days.
      </p>
      <ArrowLink href={projectEnquiry} size="lg" data-enquiry>Start a project</ArrowLink>

      {/* The studio's name, address and email in crawlable markup. Local
          search scores a business on finding one consistent NAP across the
          web, and a street address that exists only in the JSON-LD is worth
          markedly less than one a visitor can also read. */}
      <address class="contact__nap">
        <span class="contact__org">{site.name}</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span>{addressLine}</span>
        <span class="contact__served">Available worldwide</span>
      </address>
    </div>
  </div>
</section>

<style>
  .contact {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }
  .contact__lede { color: var(--text-muted); max-width: 46ch; }

  .contact__nap {
    /* `address` is italic by default in every UA stylesheet. */
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: var(--t-menu);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }
  .contact__org { color: var(--text-muted); }
  .contact__nap a { color: var(--text-muted); transition: color 250ms var(--ease); }
  .contact__nap a:hover { color: var(--accent); }
  .contact__served { color: var(--text-faint); }
</style>

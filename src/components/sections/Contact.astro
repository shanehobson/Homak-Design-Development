---
import ArrowLink from '../ArrowLink.astro';
import { site, projectEnquiry } from '../../data/site';
---

{/* Placeholder shell. The comp for this section is empty — real details land
    here as a content drop, no layout work needed. */}
<section class="section" id="contact" data-section="contact" aria-labelledby="contact-title">
  <div class="container">
    <h2 class="section-title reveal" id="contact-title">Let's talk</h2>

    <div class="contact reveal" style="--reveal-delay: 140ms">
      <p class="contact__lede">
        Tell us what you're building. We'll come back to you within two business days.
      </p>
      <ArrowLink href={projectEnquiry} size="lg">Start a project</ArrowLink>
      <p class="contact__location">{site.location}</p>
    </div>
  </div>
</section>

<style>
  .contact {
    margin-top: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    text-align: center;
  }
  .contact__lede { color: var(--text-muted); max-width: 46ch; }
  .contact__location {
    font-size: var(--t-menu);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-faint);
  }
</style>

---
import { testimonials } from '../../data/testimonials';
---

<section class="section" id="testimonials" data-section="testimonials" aria-labelledby="testimonials-title">
  <div class="container">
    <h2 class="section-title reveal" id="testimonials-title">What clients say</h2>

    <ul class="list">
      {testimonials.map((item, i) => (
        <li class="card reveal" style={`--reveal-delay: ${120 + i * 120}ms`}>
          <figure class="quote">
            <span class="quote__mark" aria-hidden="true">“</span>
            <blockquote class="quote__text">
              <p>{item.quote}</p>
            </blockquote>
            <figcaption class="quote__by">
              <span class="quote__name">{item.name}</span>
              {item.detail && <span class="quote__detail">{item.detail}</span>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .list {
    list-style: none;
    margin: clamp(2.5rem, 5vw, 4rem) auto 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  /* A single review reads as one centred card rather than a full-width band. */
  .list:has(> .card:only-child) { max-width: 46rem; }

  .card {
    border: 1px solid var(--accent);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: #ffffff08;
  }

  .quote {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .quote__mark {
    font-family: var(--font-display);
    font-size: 5.5rem;
    line-height: 0.7;
    color: var(--accent);
  }

  .quote__text { margin: 0.5rem 0 0; }
  .quote__text p { margin: 0; }

  .quote__by {
    margin-top: auto;
    padding-top: clamp(1.5rem, 3vw, 2rem);
    display: grid;
    gap: 0.15rem;
  }
  .quote__name { font-size: var(--t-card); line-height: 1.3; }
  .quote__detail { font-size: var(--t-menu); color: var(--text-muted); line-height: 1.4; }
</style>

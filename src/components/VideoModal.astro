---
import { getImage } from 'astro:assets';
import { projects, projectPath } from '../data/projects';

/* One dialog serves every project, with a panel per project rendered up front
   and all but the open one carrying `hidden`.
   
   This used to serialise the projects into a `<script type="application/json">`
   for the client script to inject into a single set of empty nodes. That kept
   273 words — half the prose on the site — out of reach of search engines and
   of any agent doing text extraction, since both strip script tags before
   reading. Rendering the panels makes that copy real DOM, and turns the seven
   client links into crawlable anchors. */
const stills = Object.fromEntries(
  await Promise.all(
    projects.map(async (p) => [
      p.slug,
      (await getImage({ src: p.poster, width: 1600, format: 'webp' })).src,
    ]),
  ),
);
---

<dialog class="modal" data-modal>
  <div class="modal__inner">
    <button class="modal__close" type="button" data-modal-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      </svg>
    </button>

    {projects.map((project) => (
      <article class="panel" data-panel={project.slug} hidden>
        <div class="modal__media">
          {project.video ? (
            /* `src` and `poster` are held in data attributes and promoted on
               open, so a page with eight panels still ships no video bytes and
               no full-size poster until one is asked for. */
            <video
              data-panel-video
              data-src={project.video}
              data-poster={stills[project.slug]}
              preload="none"
              controls
              playsinline
            ></video>
          ) : (
            /* A real `src` — lazy, so a browser skips it while the panel is
               hidden, but present for image crawlers. */
            <img src={stills[project.slug]} alt={`${project.title} — site preview`} loading="lazy" />
          )}
        </div>

        <div class="modal__body">
          <h3 class="modal__title" data-panel-title id={`project-${project.slug}`}>{project.title}</h3>
          <p class="modal__cat">{project.category}</p>
          <p class="modal__desc">{project.description}</p>
          <p class="modal__links">
            <a class="modal__link" href={projectPath(project.slug)}>Read the case study →</a>
            {project.url && (
              <a class="modal__link" href={project.url} target="_blank" rel="noopener noreferrer">
                Visit the site ↗
              </a>
            )}
          </p>
        </div>
      </article>
    ))}
  </div>
</dialog>

<style>
  .modal {
    width: min(1100px, 92vw);
    max-height: 90dvh;
    padding: 0;
    border: 1px solid var(--hairline);
    background: #0e0e0e;
    color: var(--text);
    overflow: auto;
  }
  .modal::backdrop { background: #05050ce6; backdrop-filter: blur(6px); }

  .modal__inner { position: relative; }

  .modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--text);
    background: #0a0a0aa8;
    border: 1px solid var(--hairline);
    transition: border-color 250ms var(--ease);
  }
  .modal__close:hover { border-color: var(--accent); }
  .modal__close svg { width: 1.15rem; height: 1.15rem; }

  .modal__media { background: #000; }
  .modal__media video,
  .modal__media img {
    width: 100%;
    max-height: 62dvh;
    object-fit: contain;
    display: block;
  }

  .modal__body { padding: clamp(1.25rem, 3vw, 2rem); }
  .modal__title { font-size: var(--t-card); font-weight: 400; line-height: 1.3; }
  .modal__cat {
    font-size: var(--t-menu);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.25rem;
  }
  .modal__desc { margin-top: 1rem; color: var(--text-muted); max-width: 70ch; }

  .modal__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
  }
  .modal__link {
    display: inline-block;
    font-size: var(--t-menu);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--accent);
    border-bottom: 1px solid transparent;
    transition: border-color 250ms var(--ease);
  }
  .modal__link:hover { border-color: var(--accent); }

  /* Phone: the dialog becomes a full-bleed sheet so the media, not the copy,
     is the main event. The UA `<dialog>` defaults (max-width and the auto
     margins) have to be reset too, not just the width. */
  @media (max-width: 760px) {
    .modal {
      width: 100vw;
      max-width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      margin: 0;
      border: 0;
      overflow: hidden;
    }

    .modal__inner { height: 100%; }

    /* The column lives on the open panel, not on `.modal__inner`, now that the
       inner wraps eight of them. Matched with `:not([hidden])` rather than
       `.panel` so this never overrides the attribute and reveals a closed
       panel — a plain `display: flex` here would beat the UA's
       `[hidden] { display: none }` and show all eight at once. */
    .panel:not([hidden]) { display: flex; flex-direction: column; height: 100%; }

    /* Media claims the free space; min-height:0 lets it actually shrink, and
       the explicit 1fr row gives the child a definite height to resolve its
       `height: 100%` against when the sheet is short enough to shrink it. */
    .modal__media {
      flex: 1 1 auto;
      min-height: 0;
      display: grid;
      grid-template-rows: 1fr;
      overflow: hidden;
    }
    .modal__media video,
    .modal__media img {
      width: 100%;
      height: 100%;
      max-height: none;
    }

    /* Copy becomes a short scrollable footer. */
    .modal__body {
      flex: 0 0 auto;
      max-height: 38dvh;
      overflow-y: auto;
    }

    .modal__close { top: max(0.75rem, env(safe-area-inset-top)); }
  }
</style>

<script>
  const modal = document.querySelector<HTMLDialogElement>('[data-modal]');

  if (modal) {
    const panels = new Map<string, HTMLElement>();
    modal.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) =>
      panels.set(panel.dataset.panel!, panel),
    );

    let opener: HTMLElement | null = null;
    let active: HTMLElement | null = null;

    // Idempotent: safe to call from every close path, and twice in a row.
    const closePanel = (panel: HTMLElement) => {
      const video = panel.querySelector<HTMLVideoElement>('[data-panel-video]');
      if (video) {
        video.pause();
        // Drop the buffer so a closed video stops using memory and bandwidth.
        if (video.hasAttribute('src')) {
          video.removeAttribute('src');
          video.load();
        }
      }
      panel.hidden = true;
    };

    const open = (slug: string, trigger: HTMLElement) => {
      const panel = panels.get(slug);
      if (!panel) return;

      if (active && active !== panel) closePanel(active);
      opener = trigger;
      active = panel;
      panel.hidden = false;

      /* The dialog's accessible name has to follow whichever panel is open,
         so it is pointed at that panel's heading rather than set once. */
      const title = panel.querySelector<HTMLElement>('[data-panel-title]');
      if (title?.id) modal.setAttribute('aria-labelledby', title.id);

      const video = panel.querySelector<HTMLVideoElement>('[data-panel-video]');
      if (video) {
        video.poster = video.dataset.poster!;
        video.src = video.dataset.src!;
      }

      modal.showModal();
      video?.play().catch(() => { /* autoplay may be blocked; controls remain */ });
    };

    const teardown = () => {
      if (active) closePanel(active);
      active = null;
      opener?.focus();
      opener = null;
    };

    // Driven explicitly rather than off the dialog's `close` event, which does
    // not fire reliably in every embedding, leaving the video buffered.
    const close = () => {
      teardown();
      modal.close();
    };

    /* The cards are links to the case study pages. A plain click opens the
       preview here instead; a modified click (new tab, new window) is left
       to the browser so the link keeps behaving like one. */
    document.querySelectorAll<HTMLElement>('[data-project]').forEach((card) =>
      card.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        open(card.dataset.project!, card);
      }),
    );

    modal.querySelector('[data-modal-close]')!
      .addEventListener('click', close);

    // Click on the backdrop (i.e. outside .modal__inner) closes.
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    // Escape closes the dialog natively; take it over so teardown always runs.
    modal.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });

    // Belt and braces for any path that does fire the event.
    modal.addEventListener('close', teardown);
  }
</script>

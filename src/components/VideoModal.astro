---
import { getImage } from 'astro:assets';
import { projects } from '../data/projects';

/* One dialog serves every project. The details are serialised into a JSON
   script tag so the client script can populate it without a framework. */
const entries = await Promise.all(
  projects.map(async (p) => {
    const still = await getImage({ src: p.poster, width: 1600, format: 'webp' });
    return [
      p.slug,
      {
        title: p.title,
        category: p.category,
        description: p.description,
        stack: p.stack,
        still: still.src,
        video: p.video ?? null,
        url: p.url ?? null,
      },
    ];
  }),
);
const payload = Object.fromEntries(entries);
---

<script type="application/json" data-project-data set:html={JSON.stringify(payload)} />

<dialog class="modal" data-modal aria-labelledby="modal-title">
  <div class="modal__inner">
    <button class="modal__close" type="button" data-modal-close aria-label="Close">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      </svg>
    </button>

    <div class="modal__media">
      {/* Only one of these is shown per project. */}
      <video data-modal-video preload="none" controls playsinline hidden></video>
      <img data-modal-still alt="" hidden />
    </div>

    <div class="modal__body">
      <h3 class="modal__title" id="modal-title" data-modal-title></h3>
      <p class="modal__cat" data-modal-cat></p>
      <p class="modal__desc" data-modal-desc></p>
      <ul class="modal__stack" data-modal-stack></ul>
      <a class="modal__link" data-modal-link target="_blank" rel="noopener noreferrer" hidden>
        Visit the site ↗
      </a>
    </div>
  </div>
</dialog>

<style>
  .modal {
    width: min(1100px, 92vw);
    max-height: 90dvh;
    padding: 0;
    border: 1px solid var(--hairline);
    background: #0e0e0e;
    color: var(--text);
    overflow: auto;
  }
  .modal::backdrop { background: #05050ce6; backdrop-filter: blur(6px); }

  .modal__inner { position: relative; }

  .modal__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--text);
    background: #0a0a0aa8;
    border: 1px solid var(--hairline);
    transition: border-color 250ms var(--ease);
  }
  .modal__close:hover { border-color: var(--accent); }
  .modal__close svg { width: 1.15rem; height: 1.15rem; }

  .modal__media { background: #000; }
  .modal__media video,
  .modal__media img {
    width: 100%;
    max-height: 62dvh;
    object-fit: contain;
  }
  .modal__media [hidden] { display: none; }

  .modal__body { padding: clamp(1.25rem, 3vw, 2rem); }
  .modal__title { font-size: var(--t-card); font-weight: 400; line-height: 1.3; }
  .modal__cat {
    font-size: var(--t-menu);
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-top: 0.25rem;
  }
  .modal__desc { margin-top: 1rem; color: var(--text-muted); max-width: 70ch; }

  .modal__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }
  .modal__stack :global(li) {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--hairline);
    padding: 0.4em 0.75em;
  }

  .modal__link {
    display: inline-block;
    margin-top: 1.5rem;
    font-size: var(--t-menu);
    text-transform: uppercase;
    letter-spacing: var(--track-wide);
    color: var(--accent);
    border-bottom: 1px solid transparent;
    transition: border-color 250ms var(--ease);
  }
  .modal__link:hover { border-color: var(--accent); }
  .modal__link[hidden] { display: none; }
</style>

<script>
  interface Entry {
    title: string;
    category: string;
    description: string;
    stack: string[];
    still: string;
    video: string | null;
    url: string | null;
  }

  const dataEl = document.querySelector('[data-project-data]');
  const modal = document.querySelector<HTMLDialogElement>('[data-modal]');

  if (dataEl?.textContent && modal) {
    const data: Record<string, Entry> = JSON.parse(dataEl.textContent);

    const video = modal.querySelector<HTMLVideoElement>('[data-modal-video]')!;
    const still = modal.querySelector<HTMLImageElement>('[data-modal-still]')!;
    const titleEl = modal.querySelector<HTMLElement>('[data-modal-title]')!;
    const catEl = modal.querySelector<HTMLElement>('[data-modal-cat]')!;
    const descEl = modal.querySelector<HTMLElement>('[data-modal-desc]')!;
    const stackEl = modal.querySelector<HTMLElement>('[data-modal-stack]')!;
    const linkEl = modal.querySelector<HTMLAnchorElement>('[data-modal-link]')!;

    let opener: HTMLElement | null = null;

    const open = (slug: string, trigger: HTMLElement) => {
      const entry = data[slug];
      if (!entry) return;
      opener = trigger;

      titleEl.textContent = entry.title;
      catEl.textContent = entry.category;
      descEl.textContent = entry.description;
      stackEl.replaceChildren(
        ...entry.stack.map((tech) => {
          const li = document.createElement('li');
          li.textContent = tech;
          return li;
        }),
      );

      if (entry.url) {
        linkEl.href = entry.url;
        linkEl.hidden = false;
      } else {
        linkEl.hidden = true;
      }

      if (entry.video) {
        // src is attached only on open, so the page ships zero video bytes.
        video.src = entry.video;
        video.poster = entry.still;
        video.hidden = false;
        still.hidden = true;
      } else {
        still.src = entry.still;
        still.alt = `${entry.title} — site preview`;
        still.hidden = false;
        video.hidden = true;
      }

      modal.showModal();
      if (entry.video) video.play().catch(() => { /* autoplay may be blocked; controls remain */ });
    };

    // Idempotent: safe to call from every close path, and twice in a row.
    const teardown = () => {
      video.pause();
      // Drop the buffer so a closed video stops using memory and bandwidth.
      if (video.hasAttribute('src')) {
        video.removeAttribute('src');
        video.load();
      }
      opener?.focus();
      opener = null;
    };

    // Driven explicitly rather than off the dialog's `close` event, which does
    // not fire reliably in every embedding, leaving the video buffered.
    const close = () => {
      teardown();
      modal.close();
    };

    document.querySelectorAll<HTMLElement>('[data-project]').forEach((btn) =>
      btn.addEventListener('click', () => open(btn.dataset.project!, btn)),
    );

    modal.querySelector('[data-modal-close]')!
      .addEventListener('click', close);

    // Click on the backdrop (i.e. outside .modal__inner) closes.
    modal.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    // Escape closes the dialog natively; take it over so teardown always runs.
    modal.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });

    // Belt and braces for any path that does fire the event.
    modal.addEventListener('close', teardown);
  }
</script>

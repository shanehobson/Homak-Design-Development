---
import { Image } from 'astro:assets';
import filament from '../assets/sculptures/filament.png';
import knotHero from '../assets/sculptures/knot-hero.png';
import knotWhisper from '../assets/sculptures/knot-whisper.png';
---

{/* Fixed behind everything; content scrolls over it. The corner glow lives on
    `.section` (global.css) so it repeats per panel the way each comp artboard
    does — this layer carries the sculptures only, each fading in when its
    section enters the viewport. */}
<div class="backdrop" data-backdrop aria-hidden="true">
  <Image class="knot knot--hero" src={knotHero} alt="" widths={[560, 902]} loading="eager" />
  <Image class="knot knot--filament" src={filament} alt="" widths={[730]} loading="lazy" />
  <Image class="knot knot--spike" src={knotWhisper} alt="" widths={[520, 1000]} loading="lazy" />
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;

    /* The comps draw the Projects/Contact sculptures as whispers: the
       brightest pixel across either form is #1b1b1d, seven levels above the
       #141414 base. Unlike the hero render, `filament.png` and
       `knot-whisper.png` arrive pre-faded — their alpha peaks at ~0.10 rather
       than 1 — so the multiplier that lands them on #1b1b1d is 0.28, not the
       0.035 an opaque render needs. Measured per asset by compositing over the
       base: filament 0.292, whisper 0.271. */
    --whisper: 0.28;
  }

  .knot {
    position: absolute;
    width: auto;
    /* The global reset caps images at `max-width: 100%`. These are backdrop
       forms that deliberately overhang the viewport, and the cap would squash
       them against their fixed height rather than let them bleed. */
    max-width: none;
    opacity: 0;
    transition:
      opacity 1200ms var(--ease),
      transform 1600ms var(--ease);
    will-change: opacity, transform;
  }

  /* All three renders are transparent chrome on alpha — no blend mode needed,
     and all three carry margin on every side, so nothing here has to be sized
     or offset to push a hard crop edge out of frame. Vertical sizing is `%` of
     `.backdrop` rather than `vh`: this layer is `position: fixed`, so on mobile
     its box (and the `overflow: hidden` that clips it) tracks the small
     viewport while `vh` tracks the large one, and that gap is what used to cut
     a straight line across the hero sculpture. */

  /* Bottom-right, bleeding off both edges the way the comp's hero artboard
     does. 195% reproduces the framing the old 558x736 crop gave at 108%: that
     crop was the top-left corner of this same render, 736 of its 1326 rows. */
  .knot--hero {
    top: -2%;
    right: -35vw;
    height: 195%;
    transform: scale(1.06);
  }

  /* Upper-left of centre, behind and above the "Our projects" title. This
     render is landscape, so it spans the panel at its natural proportions —
     the form fades out on its own well inside the right edge instead of
     stopping at a seam. Cropped at the top only, which `top` keeps offscreen. */
  .knot--filament {
    top: -8%;
    left: -6vw;
    width: 106vw;
    height: auto;
    transform: translateY(24px);
  }

  .knot--spike {
    right: -6vw;
    bottom: -12%;
    height: 78%;
    transform: translateY(40px) rotate(-6deg);
  }

  /* Contact reuses the same form, mirrored to the bottom-left. */
  .backdrop[data-active='contact'] .knot--spike {
    right: auto;
    left: -6vw;
    scale: -1 1;
  }

  /* Section in view -> its sculpture appears. */
  .backdrop[data-active='hero'] .knot--hero {
    opacity: 1;
    transform: scale(1);
  }
  .backdrop[data-active='work'] .knot--filament {
    opacity: var(--whisper);
    transform: translateY(0);
  }
  .backdrop[data-active='work'] .knot--spike,
  .backdrop[data-active='contact'] .knot--spike {
    opacity: var(--whisper);
    transform: translateY(0) rotate(0deg);
  }
  /* The comp's Team artboard carries the glow and nothing else. */

  @media (max-width: 760px) {
    /* Framed the way the desktop hero is: the form runs off the right edge of
       the viewport rather than sitting whole inside it. Seated low so the
       overhang crops the sculpture's side, not its bottom loop — the same
       read as the comp, scaled to the narrow panel.

       Mobile bleeds harder than desktop rather than matching it. Desktop's
       -35vw clips about 42% of the form; at 390x844 the same value clipped
       38%, and at that width the sculpture still read as a whole object
       nudged off-centre rather than one the frame cuts into.

       -47vw clips about 43% of the form, keeping the left arc and one inner
       loop on screen. The edge can take a good deal more before the shape
       stops reading as the knot — -65vw was tried and left only the outer
       loop, an anonymous curve rather than the sculpture — but this sits
       comfortably short of that.

       The form is larger than the panel strictly needs, which is what lets
       it sit this low — the extra height is spent below the fold, so the
       bottom loop leaves the viewport instead of stopping inside it and
       drawing a visible edge.

       `bottom` is a percentage rather than a pixel offset so the drop scales
       with the viewport: -20% puts the form's lower edge about 150px below
       the fold on a 390x844 phone, and proportionally less on a shorter one,
       which keeps the framing the same instead of swallowing the sculpture
       on small screens. About three quarters of the form's height is still
       above the fold at that offset. */
    .knot--hero {
      top: auto;
      bottom: -20%;
      right: -47vw;
      height: 74%;
      transform: scale(1.06);
    }
    .backdrop[data-active='hero'] .knot--hero {
      opacity: 0.32;
      transform: scale(1);
    }
    .knot--filament { top: -4%; left: -14vw; width: 128vw; }
    .knot--spike { height: 42%; right: -14vw; bottom: -6%; }
  }

  /* No JS: show the sculptures rather than an empty gradient. */
  :global(html.no-js) .knot--hero { opacity: 0.55; transform: none; }
  :global(html.no-js) .knot--filament,
  :global(html.no-js) .knot--spike { opacity: var(--whisper); transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .knot { transition: opacity 200ms linear; transform: none !important; }
  }
</style>

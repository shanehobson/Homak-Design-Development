---
import { Image } from 'astro:assets';
import knotBright from '../assets/sculptures/knot-bright.png';
import knotHero from '../assets/sculptures/knot-hero-raw.png';
---

{/* Fixed behind everything; content scrolls over it. The corner glow lives on
    `.section` (global.css) so it repeats per panel the way each comp artboard
    does — this layer carries the sculptures only, each fading in when its
    section enters the viewport. */}
<div class="backdrop" data-backdrop aria-hidden="true">
  <Image class="knot knot--hero" src={knotHero} alt="" widths={[560, 1120]} loading="eager" />
  {/* INTERIM: the comps put a wispy filament knot above the Projects title and
      a faint spiky form bottom-right (mirrored bottom-left on Contact). Those
      two renders don't exist yet, so the existing pair stands in at the comp's
      brightness — only their specular edges survive at `--whisper`. */}
  <Image class="knot knot--filament" src={knotHero} alt="" widths={[720, 1440]} loading="lazy" />
  <Image class="knot knot--spike" src={knotBright} alt="" widths={[520, 1040]} loading="lazy" />
</div>

<style>
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;

    /* The comps draw the Projects/Contact sculptures as whispers: the
       brightest pixel across either form is #1b1b1d, seven levels above the
       #141414 base. Near-white specular over that base needs ~0.035. */
    --whisper: 0.035;
  }

  .knot {
    position: absolute;
    width: auto;
    opacity: 0;
    transition:
      opacity 1200ms var(--ease),
      transform 1600ms var(--ease);
    will-change: opacity, transform;
  }

  /* Both renders are transparent chrome on alpha — no blend mode needed. */
  .knot--hero {
    top: 52%;
    right: -7vw;
    height: 108vh;
    transform: translateY(-50%) scale(1.06);
  }

  /* Upper-left of centre, behind and above the "Our projects" title. */
  .knot--filament {
    top: -18vh;
    left: 4vw;
    height: 130vh;
    transform: translateY(24px);
  }

  .knot--spike {
    right: -8vw;
    bottom: -14vh;
    height: 68vh;
    transform: translateY(40px) rotate(-6deg);
  }

  /* Contact reuses the same form, mirrored to the bottom-left. */
  .backdrop[data-active='contact'] .knot--spike {
    right: auto;
    left: -8vw;
    scale: -1 1;
  }

  /* Section in view -> its sculpture appears. */
  .backdrop[data-active='hero'] .knot--hero {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }
  .backdrop[data-active='work'] .knot--filament {
    opacity: var(--whisper);
    transform: translateY(0);
  }
  .backdrop[data-active='work'] .knot--spike,
  .backdrop[data-active='contact'] .knot--spike {
    opacity: var(--whisper);
    transform: translateY(0) rotate(0deg);
  }
  /* The comp's Team artboard carries the glow and nothing else. */

  @media (max-width: 760px) {
    /* Drop the hero sculpture back so it reads as texture behind the copy
       rather than competing with it. */
    .knot--hero { top: 68%; height: 48vh; right: -22vw; }
    .knot--filament { height: 80vh; left: -10vw; top: -8vh; }
    .knot--spike { height: 34vh; right: -18vw; bottom: -6vh; }
    .backdrop[data-active='hero'] .knot--hero { opacity: 0.32; }
  }

  /* No JS: show the sculptures rather than an empty gradient. */
  :global(html.no-js) .knot--hero { opacity: 0.55; transform: none; }
  :global(html.no-js) .knot--filament,
  :global(html.no-js) .knot--spike { opacity: var(--whisper); transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .knot { transition: opacity 200ms linear; transform: none !important; }
  }
</style>
